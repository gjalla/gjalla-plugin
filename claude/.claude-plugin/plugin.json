{
  "name": "gjalla",
  "version": "0.1.1",
  "description": "Observability for your coding agent sessions.",
  "author": {
    "name": "gjalla, Inc."
  },
  "homepage": "https://gjalla.io",
  "repository": "gjalla/gjalla-plugin",
  "license": "MIT",
  "keywords": ["observability", "telemetry", "agentic-engineering"],
  "hooks": "./hooks/hooks.json",
  "mcpServers": {
    "gjalla": {
      "command": "gjalla",
      "args": ["mcp", "serve"],
      "env": {
        "GJALLA_FROM_PLUGIN": "1",
        "GJALLA_API_URL": "${GJALLA_API_URL:-}",
        "GJALLA_API_KEY": "${GJALLA_API_KEY:-}",
        "CLAUDE_CODE_USER_EMAIL": "${CLAUDE_CODE_USER_EMAIL:-}",
        "GJALLA_MANAGED": "${GJALLA_MANAGED:-}",
        "GJALLA_TEAM": "${GJALLA_TEAM:-}",
        "CLAUDE_CONFIG_DIR": "${CLAUDE_CONFIG_DIR:-}"
      }
    }
  }
}

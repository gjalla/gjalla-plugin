{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/gjalla.sh\" hook session-start --harness claude-code",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/gjalla.sh\" hook turn-end --harness claude-code",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/gjalla.sh\" hook session-end --harness claude-code",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "GJALLA_FROM_PLUGIN=1 sh \"${CLAUDE_PLUGIN_ROOT}/hooks/gjalla.sh\" rules context --phase pre_commit --event PreToolUse",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "GJALLA_FROM_PLUGIN=1 sh \"${CLAUDE_PLUGIN_ROOT}/hooks/gjalla.sh\" rules context --phase pre_push --event PreToolUse",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "GJALLA_FROM_PLUGIN=1 sh \"${CLAUDE_PLUGIN_ROOT}/hooks/gjalla.sh\" rules context --event PreToolUse --agent claude-code",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'p=$(cat); case \"$p\" in *\"git commit\"*|*\"git\"*\"commit\"*) printf %s \"$p\" | sh \"$CLAUDE_PLUGIN_ROOT/hooks/gjalla.sh\" attest add --from-hook --agent claude-code 2>/dev/null || true;; esac'"
          }
        ]
      }
    ]
  }
}
